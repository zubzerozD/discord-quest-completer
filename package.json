{
  "name": "discord-quest-completer",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:runner:win": "cargo build --release --manifest-path src-runner/Cargo.toml",
    "copy:runner:win": "node scripts/copy-runner.mjs",
    "prune:catalog": "node scripts/prune-catalog.mjs",
    "runner:win": "pnpm build:runner:win && pnpm copy:runner:win",
    "dist:win": "pnpm runner:win && pnpm tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "fuse.js": "^7.0.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^2.2.0"
  }
}
