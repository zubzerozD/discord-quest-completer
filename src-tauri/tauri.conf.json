{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Discord Quest Completer",
  "version": "0.1.0",
  "identifier": "com.zubzerozd.questcompleter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Discord Quest Completer",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4MzQ5MzQxREE2NDM1RjQKUldUME5XVGFRWk0wV1BtMWVwNSs0V1A4bGxBOThjTjUrTGpPeFBLajJEWnJ1MlNMQ2prbkxQY0cK",
      "endpoints": [
        "https://github.com/zubzerozD/discord-quest-completer/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": ["resources/*"]
  }
}
